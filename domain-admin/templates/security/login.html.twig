{% extends 'base.html.twig' %}

{% block title %}Login · Domain Admin{% endblock %}

{% block body %}
<div class="login-page">
    <form class="login-card" method="post">
        <h1>Domain Admin</h1>
        <p class="subtitle">Sign in to manage subdomain → port mappings</p>

        {% if error %}
            <p class="error">Invalid username or password.</p>
        {% endif %}

        <label for="username">Username</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" autofocus required>

        <label for="password">Password</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Log in</button>
    </form>
</div>
{% endblock %}
