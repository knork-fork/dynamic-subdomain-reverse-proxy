APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-random-secret

BASE_LOCAL_URL=http://domain-admin-webserver

# Path (inside the php-fpm container) to the shared domains config that nginx's
# resolver also reads. Mounted from the project root's config/ directory.
DOMAINS_CONFIG_PATH=/config/domains.json

# Hostname the app connects to (from inside the container) to check whether a
# port is actually listening on the host machine, not just inside the container.
HOST_GATEWAY=host.docker.internal