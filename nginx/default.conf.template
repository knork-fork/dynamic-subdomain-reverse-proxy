server {
    listen ${LISTEN_PORT};
    server_name _;

    # Internal-only: resolves Host -> backend port via config/domains.json,
    # re-read fresh by PHP on every call (see php/resolve.php).
    location = /_resolve_backend {
        internal;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/resolve.php;
        fastcgi_param HTTP_HOST $http_host;
        include fastcgi_params;
    }

    location / {
        auth_request /_resolve_backend;
        auth_request_set $backend_port $upstream_http_x_upstream_port;

        proxy_pass http://127.0.0.1:$backend_port;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_page 403 =404 /404.html;
    location = /404.html {
        internal;
        ssi on;
        root /usr/share/nginx/error-pages;
    }

    error_page 500 /500.html;
    location = /500.html {
        internal;
        root /usr/share/nginx/error-pages;
    }
}
